/**
* This is the Prisma schema file
* It defines the database models and their relationships
* Schema notes: 
  - The only mapping form HL to LS or another annotator will be projects and tasks 
  - This is to minimize coupling between HL and any annotator platform for better flexibility
  - all the flows like RBAC and task access will be managed in HL side
  - This is a basic poc schema and can be extended further based on requirements
    This is designed to be flexible enough to accommodate future flow changes
*/
generator client {
  provider = "prisma-client-js"

  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
 
}

/**
* This is the user mapping table for platform users to Human labs users
* This is to support custom authentication systems per user basis from HL side 
* NOTE : this will not create a dedicated user in Label studio, this is just a mapping table
* also the platform_user_id will be the id used through out other tables to refer to the user
* platform_user_id refers to the user id in the platform's own user management system
*/
model hl_user {
  id                Int      @id @default(autoincrement())
  platform_user_id  String @unique // "<platform_prefix>:<platform_hash>:<platform_user_id>s"
  name              String
  email             String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

/**
* This is an association table mapping users to projects 
* A user can have multiple roles in different projects
* so this will have reference to platform_user_id and project_id
* skill_track will be a json dump of skills used in this project for analysis purpose
* NOTE: The skill track is bit ambiguous now, will refine it as thing get clearer 
*/
model user_project_association {
  id                Int @id @default(autoincrement())
  platform_user_id  String
  project_id        Int
  skill_tack        Json? // to define specific skill or task types the user is eligible for in the project
  created_at        DateTime @default(now()) 
  updated_at        DateTime @updatedAt
}

/**
* This is the main project table
* this is the highest level in the hierarchy of task lifecycle
* So the logic is like so - each project might have multiple stages in the pipeline
* each stage will have multiple tasks of same type (onboarding, test, collection, annotation, review/qc)
*/
model hl_project {
  id                    Int @id @default(autoincrement())
  name                  String
  desc                  String
  annotator_project_id  Int // this is the project id in the annotator platform (label studio)
  stage_order           String // "onboarding, test, collection, annotation, review"
  current_stage         String
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
}

/**
* This table defines the stages in a project pipeline
* Each stage will have its own custom config as per the type (onboarding, test, collection, annotation, review/qcs)
* NOTE: This might be a complex and config with more depth so a nosql approach might be better
* this will have reference to the project id in hl_project table
  NOTE:this is the project_id in human labs not the LABEL STUDIO project id
*/
model project_pipeline_stage {
  id            Int      @id @default(autoincrement())
  project_id    Int 
  name          String
  desc          String
  type          String // [onboarding, test, collection, annotation, review/qc]
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

/**
* This is an association table mapping users to tasks
* so this will have reference to platform_user_id and task_id
* operation_data will have json data specific to the operation done on the task
  - annotation_data: {annotation_id}
  - review_data: {reason}
  ...etc
* assigned_at will have the timestamp when the task was assigned
* task_expiry will have the timestamp when the task is expected to be completed
* completed_at will have the timestamp when the task was actually completed
  FLOW: might run a cron job or schedular to check for expired tasks and notify users or make the task open again
*/
model user_task_association {
  id                Int      @id @default(autoincrement())
  platform_user_id  String
  task_id           Int
  operation_data    Json? 
  // { annotation_data: {annotation_id}, review_data: {reason} ...etc}
  assigned_at       DateTime @default(now())
  task_expiry       DateTime? 
  completed_at      DateTime?
}

/**
* This is the main task table
* Each task will have reference to the project it belongs to
* and also the annotator_task_id in the annotator platform (label studio)
* type will define the type of task (collection, annotation, review/qc)
* status will define the current status of the task (assigned, open, completed)
*/
model hl_task {
  id                    Int      @id @default(autoincrement())
  project_id            Int
  annotator_task_id     Int // this is the task id in the annotator platform (label studio)
  name                  String
  desc                  String
  type                  String // collection, annotation, review/qc 
  status                String // assigned, open, completed
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
}

